{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBControlAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:*:table/Incidents",
        "arn:aws:dynamodb:ap-south-1:*:table/Incidents/index/*",
        "arn:aws:dynamodb:ap-south-1:*:table/ApprovalQueue"
      ]
    },
    {
      "Sid": "InvokeRemediatorAccess",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:*:function:guardrail-remediator"
    }
  ]
}
