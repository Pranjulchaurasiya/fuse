# ==============================================================================
# Fuse Configuration Environment Variables (.env.example)
# Copy this file to .env and configure your values.
# ==============================================================================

# AWS Deployment & Region Configuration
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Control Plane API & Credentials (from SAM outputs)
CONTROL_API_URL=https://agcki2mnvi.execute-api.ap-south-1.amazonaws.com/prod
CONTROL_API_KEY=your_control_api_key_here

# Protected Target API Configuration
TARGET_API_URL=https://poim5xmgs2.execute-api.ap-south-1.amazonaws.com/prod/items
TARGET_API_ID=poim5xmgs2
TARGET_API_NAME=guardrail-demo-api
TARGET_STAGE=prod

# AWS WAFv2 Circuit Breaker Configuration
WAF_IP_SET_NAME=fuse-blocked-ips
WAF_IP_SET_ID=your_waf_ip_set_id_here
WAF_WEB_ACL_NAME=fuse-guardrail-acl
WAF_WEB_ACL_ID=your_waf_web_acl_id_here

# DynamoDB State Tables
INCIDENTS_TABLE=Incidents
DEPLOYMENTS_TABLE=Deployments
APPROVAL_QUEUE_TABLE=ApprovalQueue
TENANTS_TABLE=Fuse_Tenants

# Model & Reasoning Configuration
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
RECOVERY_WINDOW_MINUTES=15
CALLER_DOMINANCE_THRESHOLD=0.85
BEDROCK_ENRICHMENT_ENABLED=true

# Notification Webhooks (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Operator Console Password (for frontend/config.js)
OPERATOR_PASSWORD=your_operator_password_here
